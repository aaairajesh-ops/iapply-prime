# Password gate for the whole app. Commission and bonus figures are commercially
# sensitive, so the site refuses to serve anything until this is set.
PRIME_ACCESS_PASSWORD=change-me

# Storage (free, Vercel-only): Vercel dashboard -> Storage -> Create Database
# -> Blob -> Private -> connect to this project. Vercel injects
# BLOB_READ_WRITE_TOKEN automatically. The whole dataset lives in one JSON blob.
BLOB_READ_WRITE_TOKEN=

# Optional alternative: Neon Postgres via the Vercel Marketplace (also free).
# If both are set, Blob wins; force one with PRIME_STORE=blob|neon|json.
DATABASE_URL=

# Shared secret for the daily cron (GET /api/sync) and for POST /api/seed.
# Vercel sends it as "Authorization: Bearer <CRON_SECRET>" on cron calls.
CRON_SECRET=

# Only for institutions that exist solely in the logged-in agent portal
# (e.g. FHM Berlin). Paste the PHPSESSID cookie of a logged-in iapply.io agent
# session, e.g.  PHPSESSID=abc123...  — without it those institutions keep
# their last synced data and the sync log says so. Sessions expire; refresh
# the value when the log reports "agent portal session expired".
IAPPLY_PORTAL_COOKIE=
